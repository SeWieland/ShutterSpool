events {}
http {
    # Preserve the public port when Docker maps it to the internal TLS listener.
    map $http_host $public_https_port {
        default 443;
        ~:(?<request_port>[0-9]+)$ $request_port;
    }
    access_log off;
    error_log /dev/stderr crit;
    server {
        listen 443 ssl;
        server_name photographs.example.invalid;
        ssl_certificate /run/certificates/https-fullchain.pem;
        ssl_certificate_key /run/certificates/https-key.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        client_max_body_size 2m;
        location / {
            proxy_pass http://server:8080;
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header X-Forwarded-Port $public_https_port;
            proxy_set_header X-Forwarded-Prefix "";
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_buffering off;
            proxy_read_timeout 300s;
        }
        location /internal/ { return 404; }
    }
    server {
        listen 443 ssl;
        server_name identity.example.invalid;
        ssl_certificate /run/certificates/https-fullchain.pem;
        ssl_certificate_key /run/certificates/https-key.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        location = /admin { return 404; }
        location ^~ /admin/ { return 404; }
        location = /realms/master { return 404; }
        location ^~ /realms/master/ { return 404; }
        location = /realms/shutterspool {
            proxy_pass http://keycloak:8080;
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header X-Forwarded-Port $public_https_port;
            proxy_set_header X-Forwarded-Prefix "";
        }
        location /realms/shutterspool/ {
            proxy_pass http://keycloak:8080;
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header X-Forwarded-Port $public_https_port;
            proxy_set_header X-Forwarded-Prefix "";
        }
        location /resources/ {
            proxy_pass http://keycloak:8080;
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header X-Forwarded-Port $public_https_port;
            proxy_set_header X-Forwarded-Prefix "";
        }
        location /.well-known/ {
            proxy_pass http://keycloak:8080;
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header X-Forwarded-Port $public_https_port;
            proxy_set_header X-Forwarded-Prefix "";
        }
        location / { return 404; }
    }
}
