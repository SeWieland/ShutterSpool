<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <UserSecretsId>shutterspool-apphost</UserSecretsId>
    <NuGetLockFilePath>packages.$(NETCoreSdkRuntimeIdentifier).lock.json</NuGetLockFilePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.Docker" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.Dotnet" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.JavaScript" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.Valkey" Version="17.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\deploy\images\compose.yaml" Link="deploy\images\compose.yaml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\deploy\package\components\compose.*.yaml" Link="deploy\package\components\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
