<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)\openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiGenerateDocumentsOptions>--file-name ShutterSpool_Server</OpenApiGenerateDocumentsOptions>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
    <InternalsVisibleTo Include="ShutterSpool.IntegrationTests" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" Version="10.11.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.14" PrivateAssets="all" />
    <ProjectReference Include="..\ShutterSpool.Application\ShutterSpool.Application.csproj" />
    <ProjectReference Include="..\ShutterSpool.Infrastructure\ShutterSpool.Infrastructure.csproj" />
    <ProjectReference Include="..\ShutterSpool.ServiceDefaults\ShutterSpool.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
