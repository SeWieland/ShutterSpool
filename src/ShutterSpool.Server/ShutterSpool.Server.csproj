<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)\openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiGenerateDocumentsOptions>--file-name ShutterSpool_Server</OpenApiGenerateDocumentsOptions>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ShutterSpool.IntegrationTests" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" Version="11.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0" />
    <!-- Keep the JWT and OIDC discovery packages on the same IdentityModel release. -->
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.23.0" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="11.0.0" PrivateAssets="all" />
    <ProjectReference Include="..\ShutterSpool.Application\ShutterSpool.Application.csproj" />
    <ProjectReference Include="..\ShutterSpool.Infrastructure\ShutterSpool.Infrastructure.csproj" />
    <ProjectReference Include="..\ShutterSpool.ServiceDefaults\ShutterSpool.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
